rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users ────────────────────────────────────────────────────────────────
    // Profile document: /users/{uid}
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Wishlist sub-collection: /users/{uid}/wishlist/{gameId}
      match /wishlist/{gameId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Entitlements: /users/{uid}/entitlements/{entitlementId}
      // Read-only for the user; all writes come from Cloud Functions (admin SDK).
      match /entitlements/{entitlementId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false; // Server-only via Admin SDK
      }
    }

    // ─── Promo codes ──────────────────────────────────────────────────────────
    // No direct client access — validated entirely in Cloud Functions.
    match /promoCodes/{code} {
      allow read, write: if false;
    }

    // ─── Code redemptions ─────────────────────────────────────────────────────
    match /codeRedemptions/{redemptionId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false; // Cloud Functions only
    }

    // ─── bKash submissions ────────────────────────────────────────────────────
    // Users can create their own submissions; read their own; no updates from client.
    match /bkashSubmissions/{submissionId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Admin SDK only
    }

    // ─── Payments ─────────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false; // Paddle webhook via Admin SDK
    }

    // ─── Audit log ────────────────────────────────────────────────────────────
    match /auditLog/{logId} {
      allow read, write: if false; // Admin SDK only
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
