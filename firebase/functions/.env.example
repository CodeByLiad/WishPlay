# Paddle Environment (sandbox or production)
PADDLE_ENV=production

# Your Paddle API Key (Generated from Paddle Dashboard -> Developer Tools -> Authentication)
PADDLE_API_KEY=

# Your WishPlay Pro Price ID (Catalog -> Products -> WishPlay Pro -> Price ID starting with pri_...)
PADDLE_PRICE_ID=

# Your Webhook Secret (Developer Tools -> Notifications -> Webhook Secret Key starting with pdl_ntf_set_...)
PADDLE_WEBHOOK_SECRET=

# bKash Personal Number (Default: 01978900129)
BKASH_NUMBER=01978900129
