rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'mdliad.se@gmail.com') ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'hyathis.x@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ─── Users ────────────────────────────────────────────────────────────────
    // Profile document: /users/{uid}
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Wishlist sub-collection: /users/{uid}/wishlist/{gameId}
      match /wishlist/{gameId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Entitlements: /users/{uid}/entitlements/{entitlementId}
      match /entitlements/{entitlementId} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
        allow write: if isAdmin();
      }
    }

    // ─── Admins ────────────────────────────────────────────────────────────────
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // ─── Promo codes ──────────────────────────────────────────────────────────
    match /promoCodes/{code} {
      allow read, write: if isAdmin();
      allow read: if request.auth != null;
      allow update: if request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses']);
    }

    // ─── Code redemptions ─────────────────────────────────────────────────────
    match /codeRedemptions/{redemptionId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    // ─── bKash submissions ────────────────────────────────────────────────────
    match /bkashSubmissions/{submissionId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ─── Payments ─────────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ─── Audit log ────────────────────────────────────────────────────────────
    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
