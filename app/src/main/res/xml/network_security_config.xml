<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Require HTTPS and validate certificates against Android's system trust store.
         Firebase/Google and other providers rotate their certificate chains; do not
         pin their managed endpoints to a fixed set of third-party CA keys. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
